# ============================================================
# CyberHuntLab v1.1 — variáveis de ambiente (somente servidor)
# ============================================================

# OBRIGATÓRIA. Sem ela, toda a API responde 503 (fail-closed).
# Mínimo de 32 caracteres aleatórios. Gere com: openssl rand -base64 48
# Também deriva as chaves da sessão e do cofre de credenciais: trocá-la encerra todas as sessões
# e invalida as credenciais salvas pelos usuários.
APP_ACCESS_TOKEN=

# Servidor OpenCode padrão (acessível pelo backend) e senha Basic Auth.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_PASSWORD=
# Hosts extras que os usuários podem cadastrar como "servidor OpenCode privado" (anti-SSRF).
# Lista separada por vírgulas no formato host[:porta]. O host de OPENCODE_SERVER_URL já é permitido.
# Vazio = nenhum servidor personalizado é aceito.
OPENCODE_ALLOWED_HOSTS=
OPENCODE_SKILLS_DIR=

# Chaves de servidor (opcionais). Usadas somente após login.
GITHUB_TOKEN=
GROQ_API_KEY=
OPENAI_API_KEY=

S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_SECRET_ACCESS_KEY=

# 9Router compartilhado (configurado pela administração no VPS)
NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_API_KEY=
NINEROUTER_DEFAULT_COMBO=openui-coding
